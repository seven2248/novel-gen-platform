{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": "1.0.0",
  "type": "object",
  "title": "Planner Output",
  "description": "Planner Agent 输出",
  "properties": {
    "chapter_goal": {"type": "string"},
    "beats": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "cards_attached": {
      "type": "array",
      "items": {"type": "string"}
    },
    "context_hints": {
      "type": "array",
      "items": {"type": "string"}
    },
    "required_hooks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "tone_hint": {"type": "string"}
  },
  "required": ["chapter_goal", "beats"]
}
