{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": "1.0.0",
  "type": "object",
  "title": "Committer Output",
  "description": "Committer Agent 输出（预览模式）",
  "properties": {
    "state_diff": {
      "type": "object",
      "properties": {
        "add": {
          "type": "array",
          "items": {"type": "object"}
        },
        "update": {
          "type": "array",
          "items": {"type": "object"}
        },
        "remove": {
          "type": "array",
          "items": {"type": "object"}
        }
      }
    },
    "projection_refresh_targets": {
      "type": "array",
      "items": {"type": "string"}
    },
    "warnings": {
      "type": "array",
      "items": {"$ref": "#/definitions/Warning"}
    }
  },
  "required": ["state_diff"],
  "definitions": {
    "Warning": {
      "type": "object",
      "properties": {
        "type": {"type": "string"},
        "message": {"type": "string"},
        "severity": {"type": "string", "enum": ["info", "warn", "block"]}
      },
      "required": ["type", "message"]
    }
  }
}
