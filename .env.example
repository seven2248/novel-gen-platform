# API Keys（按需配置，LiteLLM 自动根据模型前缀选择）
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
GEMINI_API_KEY=AIxxx
DEEPSEEK_API_KEY=sk-xxx

# 模型路由：每个 Agent 可配不同厂商
# 格式: {"planner": "provider/model", "writer": "...", ...}
# 支持的 provider 前缀见 https://docs.litellm.ai/docs/providers
LLM_CONFIG={"planner": "openai/gpt-4o", "writer": "openai/gpt-4o", "reviewer": "anthropic/claude-sonnet-4-6-5-20251120", "committer": "openai/gpt-4o"}

# 数据库路径（可选，默认 ~/.novel-gen/）
NOVEL_GEN_DB_DIR=~/.novel-gen
